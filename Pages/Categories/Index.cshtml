@page "{id:int?}"
@model Deac_Renata_Lab02.Pages.Categories.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CategoryData.Categories.FirstOrDefault().CategoryName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.CategoryData.Categories)
        { 
            string selectedRow = ""; 
            if (item.ID == Model.CategoryID) 
            { 
                selectedRow = "table-success"; 
            } 
            <tr class="@selectedRow">
        
            <td>
                @Html.DisplayFor(modelItem => item.CategoryName)
            </td>
            <td>
                    <a asp-page="./Index" asp-route-id="@item.ID">Select</a> |
                <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
            </td>
            </tr>
}
    </tbody>
</table>

@if (Model.CategoryData.BookCategories != null && Model.CategoryData.BookCategories.Any())
{
    <h3>Books in Selected Category</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bookCategory in Model.CategoryData.BookCategories)
            {
                <tr>
                    <td>@bookCategory.Book.Title</td> 
                    <td>@bookCategory.Book.Author.FullName</td> 
                </tr>
            }
        </tbody>
    </table>
}
else if (Model.CategoryData.BookCategories != null)
{
    <p>No books available in the selected category.</p>

}