@page
@model Deac_Renata_Lab02.Pages.Borrowings.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Borrowing</h4>
    <hr />
    <dl class="row">
        <!-- Afișează Numele Membrului -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Borrowing.Member)
        </dt>
        <dd class="col-sm-10">
            @Model.Borrowing.Member.FirstName <!-- Numele membrului -->
        </dd>

        <!-- Afișează Detaliile Cărții -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Borrowing.Book)
        </dt>
        <dd class="col-sm-10">
            @Model.Borrowing.Book.Title <!-- Titlul cărții -->
        </dd>

        <!-- Afișează Data Returnării -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Borrowing.ReturnDate)
        </dt>
        <dd class="col-sm-10">
            @Model.Borrowing.ReturnDate
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Borrowing.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
